#!/usr/bin/env python3
"""Export Caelestia's wallpaper-derived scheme as colors.css for Quickshell."""

import json
import os
import subprocess

try:
    raw = subprocess.check_output(
        ["caelestia", "wallpaper", "-p"], text=True, stderr=subprocess.DEVNULL
    ).strip()
    colours = json.loads(raw)["colours"]
except Exception:
    raise SystemExit(0)

mapping = {
    "background": "background",
    "foreground": "onSurface",
    "primary": "primary",
    "secondary": "secondary",
    "tertiary": "tertiary",
    "error": "error",
    "surface": "surface",
    "on_surface": "onSurface",
    "surface_variant": "surfaceVariant",
    "outline": "outline",
}

lines = []
for name, key in mapping.items():
    value = colours.get(key)
    if value:
        lines.append(f"@define-color {name} #{value};")

if not lines:
    raise SystemExit(0)

path = os.path.expanduser("~/.config/quickshell/colors.css")
tmp = path + ".tmp"
with open(tmp, "w") as f:
    f.write("\n".join(lines) + "\n")
os.replace(tmp, path)
