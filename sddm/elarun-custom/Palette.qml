// Static cool-dark palette for the Prompt SDDM theme.
// Kept independent of matugen: Caelestia owns the live desktop scheme,
// the greeter keeps the same fixed look as the notification island.
import QtQuick 2.0

QtObject {
    property color background: "#0b0b0e"
    property color surface: "#101014"
    property color outline: "#3a3a46"
    property color text: "#e8e8f0"
    property color primary: "#8ab4f8"
    property color error: "#ff8a80"
    property color tertiary: "#7dd3fc"
    property color surfaceContainerLow: "#14141a"
}
