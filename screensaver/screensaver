#!/usr/bin/env bash
# CachyOS screensaver renderer — adapted from uthman_dotfiles.
# Runs inside a fullscreen Alacritty window and animates the CachyOS logo with tte.
export PATH="$HOME/.local/bin:$PATH"

EFFECT_MODE="random"
if [[ "$1" == "--effect" && -n "$2" ]]; then
  [[ "$2" == "decrypt" ]] && EFFECT_MODE="decrypt"
elif [[ "$*" == *decrypt* ]]; then
  EFFECT_MODE="decrypt"
fi

screensaver_in_focus() {
  hyprctl activewindow -j 2>/dev/null | jq -e '.class == "org.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl keyword cursor:invisible false >/dev/null 2>&1 || true
  pkill -x tte >/dev/null 2>&1 || true
  pkill -f '[o]rg.screensaver' >/dev/null 2>&1 || true
  exit 0
}
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'
hyprctl keyword cursor:invisible true >/dev/null 2>&1 || true

TT="$(command -v tte || true)"
[ -n "$TT" ] || { echo "tte not found — run: uv tool install terminaltexteffects" >&2; exit 1; }

BRAND_FILE="$HOME/.config/branding/cachyos.txt"
[ -f "$BRAND_FILE" ] || BRAND_FILE="$HOME/.config/branding"
[ -f "$BRAND_FILE" ] || BRAND_FILE="$HOME/.config/branding/screensaver.txt"
[ -f "$BRAND_FILE" ] || BRAND_FILE="$HOME/.config/branding.txt"
[ -f "$BRAND_FILE" ] || { echo "branding file missing" >&2; exit 1; }

if [ "$EFFECT_MODE" = "decrypt" ]; then
  CMD=("$TT" -i "$BRAND_FILE" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --no-eol --no-restore-cursor decrypt)
else
  CMD=("$TT" -i "$BRAND_FILE" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --random-effect --no-eol --no-restore-cursor)
fi

GRACE_SEC=5
UNFOCUS_EXIT=3
start_ts=$(date +%s)
unfocused_since=0

while true; do
  "${CMD[@]}" &
  TPID=$!
  while kill -0 "$TPID" 2>/dev/null; do
    if read -n1 -t 1 2>/dev/null; then
      exit_screensaver
    fi
    now_ts=$(date +%s)
    if [ $((now_ts - start_ts)) -gt "$GRACE_SEC" ]; then
      if screensaver_in_focus; then
        unfocused_since=0
      else
        [ "$unfocused_since" -eq 0 ] && unfocused_since=$now_ts
        [ $((now_ts - unfocused_since)) -ge "$UNFOCUS_EXIT" ] && exit_screensaver
      fi
    fi
  done
  sleep 0.5
done
